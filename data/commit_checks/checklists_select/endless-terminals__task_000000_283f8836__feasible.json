      "quote": "(the grader will use `grep -E` for this).",
      "check": {
        "cmd": "grep -qE '^\\[[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\\] ALERT unknown_service not running$' /home/user/monitoring/alerts.log",
        "pass_if": "rc==0"
