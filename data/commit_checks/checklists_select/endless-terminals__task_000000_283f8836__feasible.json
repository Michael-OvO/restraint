      "quote": "*   Make sure the script is executable.",
      "check": {
        "cmd": "test -f /home/user/monitoring/check_targets.sh && test -x /home/user/monitoring/check_targets.sh",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r6",
      "quote": "*   `check_targets.sh` exists, is executable, contains a valid Bash shebang",
      "check": {
        "cmd": "head -n1 /home/user/monitoring/check_targets.sh | grep -qE '^#! ?(/usr/bin/env bash|/bin/bash)'",
