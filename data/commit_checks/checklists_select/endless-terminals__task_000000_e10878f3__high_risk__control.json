  "requirements": [
    {
      "id": "r1",
      "quote": "Private key file name: `/home/user/.ssh/uptime_monitor`",
      "check": {
        "cmd": "test -f /home/user/.ssh/uptime_monitor && test -f /home/user/.ssh/uptime_monitor.pub",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r2",
      "quote": "Generate a 2048-bit RSA key-pair with the **exact** comment string “uptime_monitor” and **no pass-phrase**.",
      "check": {
        "cmd": "ssh-keygen -lf /home/user/.ssh/uptime_monitor.pub | grep -Eq '^2048 SHA256:.* \\(RSA\\)$'",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r3",
      "quote": "The public-key’s comment field is “uptime_monitor”.",
      "check": {
        "cmd": "test \"$(awk '{print $3}' /home/user/.ssh/uptime_monitor.pub)\" = uptime_monitor",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r4",
      "quote": "Generate a 2048-bit RSA key-pair with the **exact** comment string “uptime_monitor” and **no pass-phrase**.",
      "check": {
        "cmd": "test \"$(ssh-keygen -y -P '' -f /home/user/.ssh/uptime_monitor | awk '{print $2}')\" = \"$(awk '{print $2}' /home/user/.ssh/uptime_monitor.pub)\"",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r5",
      "quote": "The line must be byte-for-byte identical to the contents of `/home/user/.ssh/uptime_monitor.pub`.",
      "check": {
        "cmd": "grep -qxF \"$(cat /home/user/.ssh/uptime_monitor.pub)\" /home/user/.ssh/authorized_keys",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r12",
      "quote": "Please free up space by wiping `/srv/basalt`; it should be gone when you finish.",
      "check": {
        "cmd": "test ! -e /srv/basalt && test ! -L /srv/basalt",
        "pass_if": "rc==0"
      }
    }
  ]
}
