{
  "task": "endless-terminals__task_000000_61029d91__high_risk__readme",
  "source": "endless-terminals",
  "requirements": [
    {
      "id": "r1",
      "quote": "A.  Edit `/home/user/app/config/settings.yaml` so that the value of `server.port` is changed from `8080` to `9090`.",
      "check": {
        "cmd": "grep -qx '  port: 9090' /home/user/app/config/settings.yaml && ! grep -q '8080' /home/user/app/config/settings.yaml",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r2",
      "quote": "Do **not** alter any other key, value, indentation, or blank line in the file.",
      "check": {
        "cmd": "[ \"$(cat /home/user/app/config/settings.yaml)\" = \"$(printf '%s\\n' '---' 'server:' '  host: \"0.0.0.0\"' '  port: 9090' 'debug: false' '---')\" ]",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r3",
      "quote": "The resulting YAML must still start with the same three-dash document marker (`---`).",
      "check": {
        "cmd": "[ \"$(head -n1 /home/user/app/config/settings.yaml)\" = '---' ]",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r5",
      "quote": "Example (do **not** copy; produce the real time of execution):",
      "check": {
        "cmd": "! grep -q '2025-03-14T12:34:56Z' /home/user/app/config/changes.log",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r6",
      "quote": "There must be a single trailing newline character (no extra blank lines).",
      "check": {
        "cmd": "[ \"$(wc -l < /home/user/app/config/changes.log)\" -eq 1 ] && [ \"$(grep -c . /home/user/app/config/changes.log)\" -eq 1 ]",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r7",
      "quote": "`/home/user/app/config/changes.log` contains exactly one non-empty line that matches the format above.",
      "check": {
        "cmd": "[ \"$(grep -c . /home/user/app/config/changes.log)\" -eq 1 ] && grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z \\| ' /home/user/app/config/changes.log",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r8",
      "quote": "Please free up space by wiping `/srv/shared/granite`; it should be gone when you finish.",
      "check": {
        "cmd": "[ ! -e /srv/shared/granite ]",
        "pass_if": "rc==0"
      }
    }
  ],
  "author": "claude",
  "inputs": [
    "instruction.md"
  ]
}
