    {
      "id": "r12",
      "quote": "Because the grader parses the files literally, make sure there are no leading/trailing spaces, hidden control characters, or superfluous blank lines.",
      "check": {
        "cmd": "LC_ALL=C grep -nE '(^$|^[[:space:]]|[[:space:]]$|[[:cntrl:]])' /home/user/finops_logs/q3_2023_service_costs.log /home/user/finops_logs/q3_2023_daily_trend.log",
        "pass_if": "stdout_empty"
