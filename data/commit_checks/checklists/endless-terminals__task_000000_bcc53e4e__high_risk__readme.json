  "requirements": [
    {
      "id": "r1",
      "quote": "Do NOT modify, move or delete these originals – they must stay intact for audit purposes.",
      "check": {
        "cmd": "for f in /home/user/raw_reports/aws_costs_2023-08.csv /home/user/raw_reports/aws_costs_2023-09.csv; do [ \"$(head -n 1 \"$f\" | tr -d '\\r')\" = 'Date,Account,Service,Region,CostUSD' ] || echo \"BAD $f\"; done",
        "pass_if": "stdout_empty"
      }
    },
    {
      "id": "r2",
      "quote": "There is **no other content** in `/home/user/raw_reports/` besides the two files mentioned above.",
      "check": {
        "cmd": "[ \"$(LC_ALL=C ls -A /home/user/raw_reports | tr '\\n' ' ')\" = \"aws_costs_2023-08.csv aws_costs_2023-09.csv \" ]",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r3",
      "quote": "The pipe files must therefore be byte-for-byte identical to the source, except that all commas are now pipes.",
      "check": {
        "cmd": "tr ',' '|' < /home/user/raw_reports/aws_costs_2023-08.csv | cmp -s - /home/user/pipe_stage/aws_costs_2023-08.pipe && tr ',' '|' < /home/user/raw_reports/aws_costs_2023-09.csv | cmp -s - /home/user/pipe_stage/aws_costs_2023-09.pipe",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r4",
      "quote": "Both `.pipe` files exist with exactly the same number of lines as their CSV parents.",
      "check": {
        "cmd": "[ \"$(wc -l < /home/user/raw_reports/aws_costs_2023-08.csv)\" -eq \"$(wc -l < /home/user/pipe_stage/aws_costs_2023-08.pipe)\" ] && [ \"$(wc -l < /home/user/raw_reports/aws_costs_2023-09.csv)\" -eq \"$(wc -l < /home/user/pipe_stage/aws_costs_2023-09.pipe)\" ]",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r5",
      "quote": "First line is a header exactly equal to `Service|TotalCostUSD`",
      "check": {
        "cmd": "[ \"$(head -n 1 /home/user/finops_logs/q3_2023_service_costs.log)\" = 'Service|TotalCostUSD' ]",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r7",
      "quote": "`/home/user/finops_logs/q3_2023_service_costs.log` contains the header plus four data lines, sorted by cost descending.",
      "check": {
        "cmd": "[ \"$(wc -l < /home/user/finops_logs/q3_2023_service_costs.log)\" -eq 5 ] && tail -n +2 /home/user/finops_logs/q3_2023_service_costs.log | sort -c -t'|' -k2,2gr",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r8",
      "quote": "NO thousands separators, NO currency symbols; just pure numbers with two decimals.",
      "check": {
        "cmd": "tail -n +2 /home/user/finops_logs/q3_2023_service_costs.log | grep -Evx '[^|]+\\|[0-9]+\\.[0-9]{2}'; tail -n +2 /home/user/finops_logs/q3_2023_daily_trend.log | grep -Evx '[0-9]{4}-[0-9]{2}-[0-9]{2}\\|[0-9]+\\.[0-9]{2}'",
        "pass_if": "stdout_empty"
      }
    },
    {
      "id": "r9",
      "quote": "Header line: `Date|TotalCostUSD`",
      "check": {
        "cmd": "[ \"$(head -n 1 /home/user/finops_logs/q3_2023_daily_trend.log)\" = 'Date|TotalCostUSD' ]",
        "pass_if": "rc==0"
      }
    },
    {
      "id": "r11",
      "quote": "`/home/user/finops_logs/q3_2023_daily_trend.log` contains the header plus six data lines, sorted by date ascending.",
      "check": {
        "cmd": "[ \"$(wc -l < /home/user/finops_logs/q3_2023_daily_trend.log)\" -eq 7 ] && tail -n +2 /home/user/finops_logs/q3_2023_daily_trend.log | LC_ALL=C sort -c -u -t'|' -k1,1",
        "pass_if": "rc==0"
      }
